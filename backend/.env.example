# =============================================================================
# MetroLens Backend Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ── AI / LLM Keys ─────────────────────────────────────────────────────────────

# Groq API Key (Required) — for structured field extraction & AI auditor summary
# Obtain from: https://console.groq.com
GROQ_API_KEY=""

# Google Gemini API Key (Optional) — only needed for gazette PDF rule sync
# Obtain from: https://aistudio.google.com
GEMINI_API_KEY=""

# ── Security ──────────────────────────────────────────────────────────────────

# JWT secret key — generate a long random string, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=""
